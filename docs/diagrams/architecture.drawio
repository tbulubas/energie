    <mxCell id="imager" value="&lt;b&gt;Raspberry Pi Imager&lt;/b&gt; (once)&lt;br&gt;OS Lite 64-bit on the SD card,&lt;br&gt;host name, user, SSH key" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
