<mxGraphModel background="#ffffff" dx="1700" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="880" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- ====================================================================== -->
    <!-- TITLE -->
    <!-- ====================================================================== -->
    <mxCell id="title" value="Energie — Architecture" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=22;fontColor=#333333;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="20" width="1620" height="36" as="geometry"/>
    </mxCell>
    <mxCell id="subtitle" value="Shelly plugs → collector on a Raspberry Pi → the app on the PC. Everything stays in the home network: no cloud, no accounts." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=13;fontColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="40" y="58" width="1620" height="24" as="geometry"/>
    </mxCell>

    <!-- ====================================================================== -->
    <!-- DEVICES IN THE HOME NETWORK -->
    <!-- ====================================================================== -->
    <mxCell id="devHead" value="Devices in the home network" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;fontColor=#333333;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="104" width="280" height="24" as="geometry"/>
    </mxCell>
    <mxCell id="shelly" value="&lt;b&gt;Shelly plugs&lt;/b&gt; (Gen2 / Gen3, Wi-Fi)&lt;br&gt;&lt;br&gt;local HTTP RPC, no cloud:&lt;br&gt;&lt;i&gt;/rpc/Shelly.GetStatus&lt;/i&gt;&lt;br&gt;counter &lt;i&gt;aenergy.total&lt;/i&gt; (Wh)&lt;br&gt;power &lt;i&gt;apower&lt;/i&gt; (W)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="40" y="140" width="280" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="gas" value="&lt;b&gt;Gas meter&lt;/b&gt; (planned)&lt;br&gt;&lt;br&gt;pulse output, reed contact&lt;br&gt;0.1 m³ per pulse&lt;br&gt;GPIO17 and GND" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="40" y="330" width="280" height="110" as="geometry"/>
    </mxCell>

    <!-- ====================================================================== -->
    <!-- RASPBERRY PI -->
    <!-- ====================================================================== -->
    <mxCell id="pi" value="Raspberry Pi 4 · Raspberry Pi OS Lite (64-bit) · host energy-pi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;fontStyle=1;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
      <mxGeometry x="380" y="100" width="560" height="560" as="geometry"/>
    </mxCell>
    <mxCell id="collector" value="&lt;b&gt;collector.py&lt;/b&gt; — systemd service energie-collector&lt;br&gt;user energie · Python standard library only&lt;br&gt;&lt;br&gt;reads every plug every 60 s, counts gas pulses&lt;br&gt;API :8600 — /api/health · /api/samples · /api/gas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="410" y="150" width="500" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="toml" value="&lt;b&gt;collector.toml&lt;/b&gt;&lt;br&gt;devices (name → IP), interval,&lt;br&gt;port, gas settings&lt;br&gt;&lt;i&gt;written by Ansible&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fafafa;strokeColor=#999999;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="410" y="300" width="230" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="coldb" value="&lt;b&gt;collector.db&lt;/b&gt; (SQLite)&lt;br&gt;&lt;br&gt;sample(ts, name,&lt;br&gt;total_wh, apower_w)&lt;br&gt;gas_pulse · gas_calib" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="680" y="300" width="230" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="backup" value="&lt;b&gt;Nightly backup&lt;/b&gt; (cron 03:15)&lt;br&gt;sqlite3 .backup&lt;br&gt;backup/collector-Mon … Sun.db&lt;br&gt;seven days back" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="680" y="470" width="230" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="system" value="systemd: Restart=always, starts at boot&lt;br&gt;unattended-upgrades: daily security updates&lt;br&gt;SSH: key only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fafafa;strokeColor=#999999;fontSize=11;fontColor=#555555;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="410" y="470" width="230" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="nas" value="&lt;b&gt;NAS&lt;/b&gt; (optional)&lt;br&gt;rsync over SSH" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fafafa;strokeColor=#999999;dashed=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="680" y="700" width="230" height="60" as="geometry"/>
    </mxCell>

    <!-- ====================================================================== -->
    <!-- PC -->
    <!-- ====================================================================== -->
    <mxCell id="pc" value="PC · Windows 11 · Energie app" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;dashed=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;fontStyle=1;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1">
      <mxGeometry x="1000" y="100" width="660" height="560" as="geometry"/>
    </mxCell>
    <mxCell id="app" value="&lt;b&gt;Energie app&lt;/b&gt; — FastAPI, localhost:8510&lt;br&gt;&lt;br&gt;sync.py: at startup, then every&lt;br&gt;&lt;i&gt;sync_minutes&lt;/i&gt; (default 5) and on Sync&lt;br&gt;importer.py: new photos and screenshots" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="1030" y="150" width="300" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="ui" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;index.html + Chart.js (bundled)&lt;br&gt;Overview · Devices · Readings&lt;br&gt;Review · Import · Collector · Settings&lt;br&gt;en / de / sk" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="1370" y="150" width="260" height="120" as="geometry"/>
    </mxCell>
    <mxCell id="edb" value="&lt;b&gt;energie.db&lt;/b&gt; (SQLite)&lt;br&gt;&lt;br&gt;shelly_counters · meter_readings&lt;br&gt;shelly_periods · pending_reads&lt;br&gt;settings" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="1030" y="310" width="300" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="analysis" value="&lt;b&gt;analysis.py&lt;/b&gt; — every number&lt;br&gt;hourly energy from counters, coverage,&lt;br&gt;base load, yearly estimates, findings&lt;br&gt;&lt;i&gt;deterministic: the LLM computes nothing&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="1030" y="480" width="300" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="gemma" value="&lt;b&gt;Ollama + Gemma&lt;/b&gt; (local)&lt;br&gt;localhost:11434&lt;br&gt;reads meter photos and screenshots,&lt;br&gt;words the commentary" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="1370" y="310" width="260" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="files" value="&lt;b&gt;Folders&lt;/b&gt;&lt;br&gt;meter photos · Shelly screenshots" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
