    <mxCell id="ansible" value="&lt;b&gt;Ansible in WSL&lt;/b&gt; (make deploy)&lt;br&gt;site.yml: base · collector · backup&lt;br&gt;discover.yml: finds the Shelly devices&lt;br&gt;inventory.yml: local, not in git" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
