# Managed by Ansible (deploy/): change inventory.yml and run make deploy, not this file.
db = {{ collector_db | string | to_json }}
interval_s = {{ collector_interval_s | int }}
port = {{ collector_port | int }}

[devices]
{% for name, host in collector_devices.items() %}
{{ name | string | to_json }} = {{ host | string | to_json }}
{% endfor %}

[gas]
enabled = {{ collector_gas_enabled | bool | lower }}
pin = {{ collector_gas_pin | int }}
m3_per_pulse = {{ collector_gas_m3_per_pulse | float }}
debounce_s = {{ collector_gas_debounce_s | float }}
