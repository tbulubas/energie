# Files that run on the Raspberry Pi / Odroid keep LF line endings even when
# checked out on Windows with core.autocrlf=true (a CRLF shebang breaks sh).
*.sh        text eol=lf
*.service   text eol=lf
collector/** text eol=lf
deploy/**    text eol=lf

# Windows launcher
*.bat       text eol=crlf

*.png       binary
